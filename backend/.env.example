# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=kvitto
DB_PASSWORD=change_me_in_production
DB_NAME=kvitto

# JWT
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=production

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Currency API (exchangerate.host - free, no key required)
CURRENCY_API_URL=https://api.exchangerate.host/live
CURRENCY_BASE=DKK

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# SMTP (til invite-emails)
SMTP_HOST=mail.ditdomaene.dk
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=kvitto@ditdomaene.dk
SMTP_PASS=din-smtp-adgangskode
SMTP_FROM=Kvitto <kvitto@ditdomaene.dk>
APP_URL=https://kvitto.ditdomaene.dk

# GitHub (til auto-update fra admin-panel)
GITHUB_REPO=dit-brugernavn/kvitto
APP_DIR=/opt/kvitto
